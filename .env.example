# Public site URL (used for metadata, OG images, sitemap)
NEXT_PUBLIC_SITE_URL=https://premora.ae

# MapLibre style / tile token. If empty, the map falls back to a styled static preview.
NEXT_PUBLIC_MAPTILER_KEY=

# Lead capture email (Resend). Email send is stubbed unless ENABLE_EMAIL=true.
ENABLE_EMAIL=false
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hello@premora.ae
